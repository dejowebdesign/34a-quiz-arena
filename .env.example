# ---------------------------------------------------------------------------
# 34A Quiz Arena - Beispielkonfiguration
# Diese Datei nach .env kopieren und Werte anpassen. .env niemals committen.
# ---------------------------------------------------------------------------

# Laufzeitumgebung: production oder development
NODE_ENV=production

# Port im Container (der Reverse Proxy leitet hierhin weiter)
PORT=3000

# Pfad zur SQLite-Datenbank innerhalb des Containers
DB_PATH=/app/data/quiz-arena.db

# Pflicht: zufaelliges Geheimnis zum Signieren der Sitzungs- und Join-Tickets.
# Erzeugen mit: openssl rand -hex 32
SESSION_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen

# Moderatorenzugang. Genau eine der beiden Varianten setzen.
#
# WICHTIG bei Docker Compose: In dieser Datei wird jedes einfache Dollarzeichen
# als Variablenverweis gelesen. Ein scrypt-Hash besteht aus mehreren mit Dollar
# getrennten Teilen und muss deshalb mit doppelten Dollarzeichen geschrieben
# werden. Sonst wird der Hash abgeschnitten und die Anmeldung schlaegt fehl.
#
#   Hash erzeugen:  node server/scripts/hash-password.mjs "DeinPasswort"
#   Ergebnis:       scrypt$16384$8$1$<salt-hex>$<hash-hex>
#   In .env so:     ADMIN_PASSWORD_HASH=scrypt$$16384$$8$$1$$<salt-hex>$$<hash-hex>
#
# Im Portainer-Formular (Environment variables) dagegen die einfachen
# Dollarzeichen eintragen, dort findet keine Ersetzung statt.
#
# Variante A (empfohlen): scrypt-Hash, niemals das Klartextpasswort speichern.
#ADMIN_PASSWORD_HASH=scrypt$$16384$$8$$1$$<salt-hex>$$<hash-hex>
# Variante B: Klartextpasswort, wird beim Start gehasht (nur fuer den Einstieg).
ADMIN_PASSWORD=aendere-mich-sofort
# Benutzername fuer die Moderation
ADMIN_USER=moderator

# Cookies nur ueber HTTPS senden (hinter HTTPS-Proxy: true)
COOKIE_SECURE=true

# X-Forwarded-* Header des Reverse Proxys auswerten
TRUST_PROXY=true

# Optional: erlaubte Origins (Komma-getrennt). Leer = gleiche Origin wie der Server.
#ALLOWED_ORIGINS=https://quiz-arena.duckdns.org

# Optional: KI-Joker. Ohne Key liefert der Joker einen Regelhinweis aus den Fragenmetadaten.
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1
